{
  "_version": "1.59.0",
  "sap.app": {
    "id": "zmaxx.upload",
    "type": "application",
    "title": "Journal Upload",
    "description": "Upload journal entries with business rules, Sort & Split and approval routing (F2548 side-by-side extension)",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "zmaxx": {
        "uri": "/odata/v4/zmaxx/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "upload": {
          "semanticObject": "ZmaxxJournal",
          "action": "upload",
          "title": "Journal Upload",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": false
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.f": {},
        "sap.ui.unified": {},
        "sap.ui.layout": {}
      }
    },
    "rootView": {
      "viewName": "zmaxx.upload.view.Main",
      "type": "XML",
      "id": "main"
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "zmaxx-f2548-ext"
  }
}
